          }
        }
      }
    },
    "点上面 **打开快捷指令**，在底部选 **自动化**，点右上角 **+**，选 **信息**，条件都不填。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
