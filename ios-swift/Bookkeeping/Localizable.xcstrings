                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld foreign-currency transactions have no rate yet and aren’t in the balance."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有 %lld 笔外币交易还没有汇率，没算进余额"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有 %lld 筆外幣交易還沒有匯率，沒算進餘額"
