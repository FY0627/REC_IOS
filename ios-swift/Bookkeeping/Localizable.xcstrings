        }
      }
    },
    "只保存在这台 iPhone，App 不联网。汇率由快捷指令下载后导入。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on this iPhone and REC never goes online. Exchange rates are downloaded by Shortcuts and imported."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保存在这台 iPhone，App 不联网。汇率由快捷指令下载后导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只儲存在這支 iPhone，App 不連網。匯率由「捷徑」下載後匯入。"
          }
        }
      }
    },
    "只删除这一边，另一边的账户还留着这笔。删除后不能恢复" : {
      "localizations" : {
